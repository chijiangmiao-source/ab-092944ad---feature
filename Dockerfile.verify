FROM node:20-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}" \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN pip install --no-cache-dir pytest==8.3.4 fastapi==0.115.6 \
    'uvicorn[standard]==0.34.0' pydantic==2.10.4 httpx==0.28.1

WORKDIR /workspace
COPY backend /workspace/backend
COPY frontend /workspace/frontend
COPY verify /workspace/verify

RUN cd /workspace/frontend && npm ci --no-audit --no-fund

CMD ["python3", "/workspace/verify/run_verify.py"]
